{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(curl:*)",
      "mcp__github__merge_pull_request",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__pull_request_read",
      "mcp__github__list_pull_requests",
      "mcp__github__add_issue_comment",
      "mcp__github__create_or_update_file",
      "mcp__github__push_files"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$(git status --porcelain 2>/dev/null)\" ]; then echo 'Reminder: uncommitted changes remain. Commit, update PROGRESS.md and TASKS.md, and push the branch before ending the run.'; fi"
          }
        ]
      }
    ]
  }
}
